              placeholder="XXXXXXXXXXXX"
              placeholderTextColor="#999"
            />

            <Text style={[styles.fieldLabel, textStartStyle()]}>
              {t('partner.enterPin')}
            </Text>
            <TextInput
              style={[styles.input, textStartStyle()]}
              value={partnerPinInput}
