import { useRouter } from 'expo-router';
import { useMemo } from 'react';
import { useTranslation } from 'react-i18next';
import {
  ActivityIndicator,
  Pressable,
  ScrollView,
  StyleSheet,
  Text,
  View,
} from 'react-native';

import type { VesetResult, VesetType } from '../../calculations/types';
import { useDeletePeriod } from '../../hooks/useDeletePeriod';
import type { SupportedLanguage } from '../../i18n';
import { showAlert } from '../../utils/alert';
import { formatGregorianDisplay } from '../../utils/formatGregorianDisplay';
import { formatHebrewDate } from '../../utils/hebrewDateFormat';
import { textStartStyle } from '../../utils/rtl';
import { getFutureVesetim } from '../../utils/upcomingVesetim';
import { vesetBadgeColors } from '../../utils/vesetBadgeColors';

function vesetTranslationKey(type: VesetType): string {
  return `veset.${type}`;
}

export interface UpcomingVesetimFullListProps {
  vesetim: VesetResult[];
}

export function UpcomingVesetimFullList({ vesetim }: UpcomingVesetimFullListProps) {
  const { t, i18n } = useTranslation();
  const router = useRouter();
  const language = i18n.language as SupportedLanguage;
  const { remove, isDeleting } = useDeletePeriod();

  const upcoming = useMemo(() => getFutureVesetim(vesetim), [vesetim]);

  function confirmDelete(sourcePeriodId: string) {
    showAlert(
      t('period.deleteConfirmTitle'),
      t('period.deleteConfirmMessage'),
      [
        { text: t('common.cancel'), style: 'cancel' },
        {
          text: t('upcoming.delete'),
          style: 'destructive',
          onPress: () => {
            void remove(sourcePeriodId);
          },
        },
      ],
    );
  }

  if (upcoming.length === 0) {
    return (
      <Text style={[styles.empty, textStartStyle()]}>
        {t('upcoming.noFuture')}
      </Text>
    );
  }

  return (
    <ScrollView
      style={styles.list}
      contentContainerStyle={styles.listContent}
      keyboardShouldPersistTaps="handled"
    >
      {upcoming.map((veset) => {
        const badge = vesetBadgeColors(veset.type);
        return (
          <View key={veset.id} style={styles.row}>
            <View style={styles.rowMain}>
              <Text style={[styles.dates, textStartStyle()]}>
                {formatHebrewDate(veset.dateHebrew, language)}
              </Text>
              <Text style={[styles.datesSecondary, textStartStyle()]}>
                {formatGregorianDisplay(veset.dateGregorian, language)}
              </Text>

              <View style={styles.metaRow}>
                <View
                  style={[styles.badge, { backgroundColor: badge.background }]}
                >
                  <Text style={[styles.badgeText, { color: badge.text }]}>
                    {t(vesetTranslationKey(veset.type))}
                  </Text>
                </View>
                <Text style={[styles.onah, textStartStyle()]}>
                  {t(veset.onah === 'day' ? 'period.day' : 'period.night')}
                </Text>
              </View>
            </View>

            <View style={styles.actions}>
              <Pressable
                style={styles.actionButton}
                onPress={() =>
                  router.push(`/(app)/edit-period/${veset.sourcePeriodId}`)
                }
              >
                <Text style={styles.actionEdit}>{t('upcoming.edit')}</Text>
              </Pressable>
              <Pressable
                style={styles.actionButton}
                onPress={() => confirmDelete(veset.sourcePeriodId)}
                disabled={isDeleting}
              >
                {isDeleting ? (
                  <ActivityIndicator size="small" />
                ) : (
                  <Text style={styles.actionDelete}>{t('upcoming.delete')}</Text>
                )}
              </Pressable>
            </View>
          </View>
        );
      })}
