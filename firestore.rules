rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function coupleData(coupleId) {
      return get(/databases/$(database)/documents/couples/$(coupleId)).data;
    }

    function isCoupleMember(coupleId) {
      return isAuthenticated()
        && request.auth.uid in coupleData(coupleId).members;
    }

    function normalizedAuthEmail() {
      return request.auth.token.email != null
        ? request.auth.token.email.lower()
        : '';
    }

    function isInviteeEmailMatch() {
      return isAuthenticated()
        && request.auth.token.email != null
        && (
          resource.data.partnerEmail == request.auth.token.email
          || resource.data.partnerEmail == normalizedAuthEmail()
        );
    }

    // Users can only read/write their own user document
    match /users/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }

    match /couples/{coupleId} {
      // Readable by members; solo couples readable so invitees can join
      allow read: if isAuthenticated() && (
        request.auth.uid in resource.data.members
        || resource.data.members.size() == 1
      );

      allow create: if isAuthenticated()
        && request.auth.uid in request.resource.data.members
        && request.resource.data.members.size() == 1;

      allow update: if isAuthenticated() && (
        request.auth.uid in resource.data.members
        || (
          resource.data.members.size() == 1
          && request.auth.uid in request.resource.data.members
          && !(request.auth.uid in resource.data.members)
          && request.resource.data.members.size() == 2
        )
      );

      allow delete: if isAuthenticated()
        && request.auth.uid in resource.data.members
        && resource.data.members.size() <= 1;

      match /periods/{periodId} {
        allow read, write: if isCoupleMember(coupleId);
      }

      match /settings/{settingsId} {
        allow read, write: if isCoupleMember(coupleId);
      }

      match /invites/{inviteId} {
        allow read: if isAuthenticated() && (
          request.auth.uid in get(/databases/$(database)/documents/couples/$(coupleId)).data.members
          || isInviteeEmailMatch()
        );

        allow create: if isCoupleMember(coupleId)
          && request.resource.data.status == 'pending';

        allow update: if isAuthenticated() && (
          isCoupleMember(coupleId)
          || (
            resource.data.status == 'pending'
            && isInviteeEmailMatch()
            && request.resource.data.status in ['accepted', 'declined']
          )
        );

        allow delete: if isCoupleMember(coupleId);
      }
    }

    // Collection group — required for collectionGroup('invites') queries
    match /{path=**}/invites/{inviteId} {
      allow read: if isInviteeEmailMatch();
    }
  }
}
