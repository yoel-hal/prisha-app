rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isCoupleMember(coupleId) {
      return isAuthenticated()
        && request.auth.uid in
           get(/databases/$(database)/documents/couples/$(coupleId)).data.members;
    }

    // True only for the partner the owner's active invite is linked to.
    function isLinkedPartner(coupleId) {
      let coupleDoc = get(/databases/$(database)/documents/couples/$(coupleId)).data;
      let ownerId = coupleDoc.members[0];
      let accessPath = /databases/$(database)/documents/users/$(ownerId)/partnerAccess/current;
      return isAuthenticated()
        && exists(accessPath)
        && get(accessPath).data.isActive == true
        && get(accessPath).data.get('partnerUid', null) == request.auth.uid;
    }

    function canAccessCouple(coupleId) {
      return isCoupleMember(coupleId) || isLinkedPartner(coupleId);
    }

    function coupleInviteDoc(coupleId) {
      return get(/databases/$(database)/documents/couples/$(coupleId)/public/invite);
    }

    function hasValidCoupleInvite(coupleId) {
      return coupleInviteDoc(coupleId).data.inviteExpiresAt > request.time;
    }

    function isJoiningCoupleViaInvite(coupleId) {
      return isAuthenticated()
        && hasValidCoupleInvite(coupleId)
        && resource.data.members.size() == 1
        && request.resource.data.members.size() == 2
        && request.auth.uid in request.resource.data.members
        && !(request.auth.uid in resource.data.members);
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.admin == true;
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /appMessages/{docId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      match /partnerAccess/{docId} {
        allow read, write: if isOwner(userId);

        // The linked partner, or anyone joining an active invite that no partner has claimed yet.
        allow get: if isAuthenticated()
          && (
            resource.data.get('partnerUid', null) == request.auth.uid
            || (resource.data.isActive == true && resource.data.get('partnerUid', null) == null)
          );

        allow update: if isAuthenticated()
          && resource.data.isActive == true
          && (
            // Claim an unclaimed invite for yourself.
            (
              resource.data.get('partnerUid', null) == null
              && request.resource.data.partnerUid == request.auth.uid
              && request.resource.data.isActive == true
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'partnerUid',
                'partnerConnectedAt',
                'partnerLastSeen',
                'isActive',
              ])
            )
            // Linked partner heartbeat.
            || (
              resource.data.get('partnerUid', null) == request.auth.uid
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['partnerLastSeen'])
            )
          );
      }
    }

    // Token -> owner lookup. Readable only by someone who already knows the token.
    match /partnerTokens/{token} {
      allow get: if isAuthenticated();
      allow create: if isAuthenticated()
        && request.resource.data.keys().hasOnly(['ownerId'])
        && request.resource.data.ownerId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
    }

    // Couple invite code -> couple. Readable only by someone who already knows the code.
    // getAfter lets a new couple and its invite be written in the same batch.
    function isMemberAfterWrite(coupleId) {
      return request.auth.uid in
        getAfter(/databases/$(database)/documents/couples/$(coupleId)).data.members;
    }

    match /coupleInvites/{code} {
      allow get: if isAuthenticated();
      allow create: if isAuthenticated()
        && request.resource.data.keys().hasOnly(['coupleId', 'inviteExpiresAt', 'inviterEmail'])
        && isMemberAfterWrite(request.resource.data.coupleId);
      allow update: if isAuthenticated()
        && request.resource.data.keys().hasOnly(['coupleId', 'inviteExpiresAt', 'inviterEmail'])
        && request.resource.data.coupleId == resource.data.coupleId
        && isMemberAfterWrite(resource.data.coupleId);
      allow delete: if isAuthenticated() && isMemberAfterWrite(resource.data.coupleId);
    }

    match /admin/stats {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /admin/{document=**} {
      allow read, write: if false;
    }

    match /adminRateLimits/{docId} {
      allow read, write: if false;
    }

    match /supportThreads/{threadId} {
      allow read, write: if isAdmin();

      match /messages/{msgId} {
        allow read, write: if isAdmin();
      }
    }

    match /broadcasts/{broadcastId} {
      allow read, write: if isAdmin();
    }

    match /appMessages/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    function isValidPeriod(d) {
      return d.dateGregorian is string && d.dateGregorian.size() <= 40
        && d.dateHebrew is map
        && d.dateHebrew.keys().hasOnly(['year', 'month', 'day'])
        && d.dateHebrew.year is number
        && d.dateHebrew.month is number
        && d.dateHebrew.day is number
        && d.onah in ['day', 'night']
        && d.createdAt is string && d.createdAt.size() <= 40
        && d.createdBy is string && d.createdBy.size() <= 128
        && (!('notes' in d) || (d.notes is string && d.notes.size() <= 2000));
    }

    function isValidSettings(d) {
      return d.minhag in ['ashkenaz', 'sfarad', 'chabad', 'teimani', 'yireim']
        && (!('chumrot' in d) || d.chumrot is map)
        && (!('notifications' in d) || d.notifications is map)
        && (!('calendar' in d) || d.calendar is map);
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    match /couples/{coupleId} {
      allow get: if canAccessCouple(coupleId)
        || (isAuthenticated() && hasValidCoupleInvite(coupleId));
      allow list: if canAccessCouple(coupleId);

      allow create: if isAuthenticated()
        && request.resource.data.keys().hasOnly(['members', 'createdAt', 'inviteCode', 'inviteExpiresAt'])
        && request.resource.data.members == [request.auth.uid];

      allow update: if (
          isCoupleMember(coupleId)
          && (
            // Refresh the invite code.
            changedKeys().hasOnly(['inviteCode', 'inviteExpiresAt'])
            // Leave the couple: remove yourself only.
            || (
              changedKeys().hasOnly(['members'])
              && request.resource.data.members == resource.data.members.removeAll([request.auth.uid])
            )
          )
        )
        || (
          isJoiningCoupleViaInvite(coupleId)
          && changedKeys().hasOnly(['members', 'inviteCode', 'inviteExpiresAt'])
          && resource.data.members[0] in request.resource.data.members
        );

      allow delete: if isCoupleMember(coupleId)
        && resource.data.members.size() <= 1;

      match /public/{docId} {
        allow read: if isAuthenticated();
        allow create, update: if isAuthenticated()
          && request.resource.data.keys().hasOnly(['inviteCode', 'inviteExpiresAt', 'inviterEmail'])
          && isMemberAfterWrite(coupleId);
        allow delete: if isCoupleMember(coupleId);
      }

      match /periods/{periodId} {
        allow read, delete: if canAccessCouple(coupleId);
        allow create: if canAccessCouple(coupleId)
          && request.resource.data.keys().hasOnly(['dateGregorian', 'dateHebrew', 'onah', 'notes', 'createdAt', 'createdBy'])
          && isValidPeriod(request.resource.data);
        allow update: if canAccessCouple(coupleId)
          && changedKeys().hasOnly(['dateGregorian', 'dateHebrew', 'onah', 'notes', 'createdAt', 'createdBy'])
          && isValidPeriod(request.resource.data);
      }

      // Legacy invites from before the couple-sharing redo; kept only so account deletion can clean them up.
      match /invites/{inviteId} {
        allow read, delete: if isCoupleMember(coupleId);
      }

      match /settings/{settingsId} {
        allow read, delete: if canAccessCouple(coupleId);
        // getAfter: onboarding creates the couple and its settings in one batch.
        allow create: if isAuthenticated()
          && isMemberAfterWrite(coupleId)
          && request.resource.data.keys().hasOnly(['minhag', 'chumrot', 'notifications', 'calendar'])
          && isValidSettings(request.resource.data);
        allow update: if canAccessCouple(coupleId)
          && changedKeys().hasOnly(['minhag', 'chumrot', 'notifications', 'calendar'])
          && isValidSettings(request.resource.data);
      }
    }
  }
}
