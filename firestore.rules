rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isCoupleMember(coupleId) {
      return isAuthenticated()
        && request.auth.uid in
           get(/databases/$(database)/documents/couples/$(coupleId)).data.members;
    }

    function coupleHasActivePartnerAccess(coupleId) {
      let coupleDoc = get(/databases/$(database)/documents/couples/$(coupleId)).data;
      let ownerId = coupleDoc.members[0];
      return exists(/databases/$(database)/documents/users/$(ownerId)/partnerAccess/current)
        && get(/databases/$(database)/documents/users/$(ownerId)/partnerAccess/current).data.isActive == true;
    }

    function canAccessCouple(coupleId) {
      return isCoupleMember(coupleId) || coupleHasActivePartnerAccess(coupleId);
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /partnerAccess/{docId} {
        allow read, write: if isOwner(userId);
        allow read: if isAuthenticated();
        allow update: if isAuthenticated()
          && resource.data.isActive == true
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['partnerLastSeen']);
      }
    }

    match /partnerTokens/{token} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /couples/{coupleId} {
      allow read: if canAccessCouple(coupleId);

      allow create: if isAuthenticated()
        && request.auth.uid in request.resource.data.members
        && request.resource.data.members.size() == 1;

      allow update: if isCoupleMember(coupleId);

      allow delete: if isCoupleMember(coupleId)
        && resource.data.members.size() <= 1;

      match /periods/{periodId} {
        allow read, write: if canAccessCouple(coupleId);
      }

      match /settings/{settingsId} {
        allow read, write: if canAccessCouple(coupleId);
      }
    }
  }
}
