{
  "expo": {
    "name": "prisha-tracker",
    "slug": "prisha-tracker",
    "scheme": "prisha-tracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "associatedDomains": ["applinks:prishatracker.app"],
      "bundleIdentifier": "com.yoel.halberstadt.prishatracker",
      "infoPlist": {
        "LSApplicationCategoryType": "public.app-category.healthcare-fitness"
      }
    },
    "android": {
      "package": "com.yoel.halberstadt.prishatracker",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "prishatracker.app",
              "pathPrefix": "/invite"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "color": "#1a1a1a"
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Allow Prisha Tracker to add vestos to your calendar.",
          "remindersPermission": "Allow Prisha Tracker to access calendar reminders."
        }
      ]
    ]
  }
}
